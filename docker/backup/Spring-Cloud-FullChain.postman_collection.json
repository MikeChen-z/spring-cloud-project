                                    "pm.test('至少 2 个 span', () => pm.expect(spans.length).to.be.at.least(2));",
                                    "const services = [...new Set(spans.map(s => s.localEndpoint.serviceName))];",
                                    "pm.test('覆盖 gateway-service 与 order-service', () => {",
                                    "    pm.expect(services).to.include('gateway-service');",
                                    "    pm.expect(services).to.include('order-service');",
                                    "});",
                                    "console.log('span 数:', spans.length, '服务:', services.join('/'));"
                                ]
                            }
                        }
