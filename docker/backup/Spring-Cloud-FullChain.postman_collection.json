                    "name": "8.1 响应头携带 X-Trace-Id",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "const traceId = pm.response.headers.get('X-Trace-Id');",
                                    "pm.test('响应头 X-Trace-Id 非空', () => pm.expect(traceId).to.be.a('string').that.is.not.empty);",
                                    "console.log('X-Trace-Id =', traceId);",
                                    "console.log('日志串联: docker compose logs order-service | Select-String ' + JSON.stringify(traceId));",
                                    "console.log('Zipkin UI: http://localhost:9411/trace/' + traceId);",
                                    "pm.collectionVariables.set('traceId', traceId);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
