                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                                    "const res = pm.response.json();",
                                    "pm.test('code=401 且提示用户名或密码错误', () => {",
                                    "    pm.expect(res.code).to.eql(401);",
                                    "    pm.expect(res.message).to.include('用户名或密码错误');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
