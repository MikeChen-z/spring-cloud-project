{
    "info": {
        "_postman_id": "spring-cloud-full-chain",
        "name": "Spring Cloud 全链路验证",
        "description": "统一返回体 Result 契约版。按文件夹顺序用 Collection Runner 一键执行：登录(自动存 token)→参数校验→网关鉴权→Seata AT→RocketMQ→Redis 缓存。\n约定：成功 {code:200,message,data}；业务/参数错误 400；未认证 401；forceFail 500。",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. 登录与参数校验",
            "item": [
                {
                    "name": "1.1 正常登录（自动保存 token）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "const res = pm.response.json();",
                                    "pm.test('code=200 且 data.token 非空', () => {",
                                    "    pm.expect(res.code).to.eql(200);",
                                    "    pm.expect(res.data.token).to.be.a('string');",
                                    "});",
                                    "// 自动把 token 写入集合变量，后续 {{token}} 请求直接复用，无需手动复制",
                                    "pm.collectionVariables.set('token', res.data.token);",
                                    "console.log('登录成功，token 已保存，userId=', res.data.userId);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"username\":\"张三\",\"password\":\"123456\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:9000/api/login",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "login"
                            ]
                        },
                        "description": "网关白名单路径。成功后 Tests 脚本自动提取 data.token 存入集合变量。"
                    }
                },
                {
