        {
            "name": "2. 网关 JWT 鉴权",
            "item": [
                {
                    "name": "2.1 无 Token 访问（网关应 401）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/1",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "1"
                            ]
                        },
                        "description": "JwtAuthGlobalFilter 在白名单外发现无 Authorization 头，直接 401。"
                    }
                },
                {
                    "name": "2.2 带 Token 访问（网关→order→Feign→user）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "const res = pm.response.json();",
                                    "pm.test('code=200 且 data.user 存在（Feign 成功）', () => {",
                                    "    pm.expect(res.code).to.eql(200);",
                                    "    pm.expect(res.data.user).to.be.an('object');",
                                    "    pm.expect(res.data.user.source).to.include('user-service');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/1",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "1"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. 下单接口参数校验",
            "item": [
                {
                    "name": "3.1 金额为 0（@DecimalMin，应 400）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                                    "pm.test('提示金额必须大于 0', () =>",
                                    "    pm.expect(pm.response.json().message).to.include('下单金额必须大于 0'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/seata/create?userId=1&amount=0",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "seata",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
                                {
                                    "key": "amount",
                                    "value": "0"
                                }
                            ]
                        },
                        "description": "类级 @Validated + 参数 @DecimalMin(0.01) → ConstraintViolationException → 400。"
                    }
                },
                {
                    "name": "3.2 缺 userId（@NotNull，应 400）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                                    "pm.test('提示缺少 userId', () =>",
                                    "    pm.expect(pm.response.json().message).to.include('userId'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/seata/create?amount=10",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "seata",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "amount",
                                    "value": "10"
                                }
                            ]
                        },
                        "description": "必填 @RequestParam 缺失 → MissingServletRequestParameterException → 400。"
                    }
                },
                {
                    "name": "3.3 userId 传字符串（类型不匹配，应 400）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                                    "pm.test('提示参数类型错误', () =>",
                                    "    pm.expect(pm.response.json().message).to.include('参数类型错误'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/seata/create?userId=abc&amount=10",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "seata",
                                "create"
