        {
            "name": "4. Seata AT 分布式事务",
            "item": [
                {
                    "name": "4.1 正常提交（下单 100）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "const res = pm.response.json();",
                                    "pm.test('提交成功且返回 orderId', () => {",
                                    "    pm.expect(res.data.success).to.eql(true);",
                                    "    pm.expect(res.data.orderId).to.not.be.null;",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8082/orders/seata/create?userId=1&amount=100",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "orders",
                                "seata",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
                                {
                                    "key": "amount",
                                    "value": "100"
                                }
                            ]
                        },
                        "description": "直连 order-service 绕过网关。全局事务：写订单 + Feign 扣余额，两阶段提交。\nSQL 验证：余额 -100、t_order +1；3 秒后积分 +100（afterCommit 普通消息）。"
                    }
                },
                {
                    "name": "4.2 回滚（forceFail=true，应 500）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// 业务异常经全局处理器返回 500；Feign 已先扣余额，Seata 二阶段自动补偿回滚",
                                    "pm.test('HTTP 500', () => pm.response.to.have.status(500));",
                                    "pm.test('code=500', () => pm.expect(pm.response.json().code).to.eql(500));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8082/orders/seata/create?userId=1&amount=100&forceFail=true",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "orders",
                                "seata",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
                                {
                                    "key": "amount",
                                    "value": "100"
                                },
                                {
                                    "key": "forceFail",
                                    "value": "true"
                                }
                            ]
                        },
                        "description": "本地事务内主动抛异常 → 全局回滚。SQL 验证：余额、订单数与 4.1 后一致；afterCommit 不触发故无积分消息。"
                    }
                }
            ]
        },
        {
            "name": "5. RocketMQ 事务消息",
            "item": [
                {
                    "name": "5.1 发送事务消息（下单 50）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "pm.test('半消息已发送', () =>",
                                    "    pm.expect(pm.response.json().data.success).to.eql(true));",
                                    "console.log('等待约 15 秒 Broker 事务回查确认后，积分 +50');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8082/orders/rocketmq/create?userId=1&amount=50",
                            "host": [
                                "localhost"
                            ],
                            "port": "8082",
                            "path": [
                                "orders",
                                "rocketmq",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
                                {
                                    "key": "amount",
                                    "value": "50"
                                }
                            ]
                        },
                        "description": "半消息→本地事务提交→Broker 回查确认→order-tx-topic 消费者加积分。\n约 15 秒后 SQL 验证：points +50，t_points_log 新增 source_topic=order-tx-topic 流水（bizNo 唯一索引保证幂等）。"
                    }
                }
            ]
        },
