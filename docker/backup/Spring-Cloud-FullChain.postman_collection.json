        {
            "name": "7. 接口幂等（Redis 防重令牌，必须按顺序执行）",
            "description": "令牌在业务执行前被 Lua 原子消费，5 分钟内一次性有效。Collection Runner 中 7.2/7.3/7.4 必须排在 7.1 之后；若 7.2 因业务原因失败（如余额不足），需重跑 7.1 取新令牌。",
            "item": [
                {
                    "name": "7.1 获取幂等令牌（自动保存 idemToken）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "const res = pm.response.json();",
                                    "pm.test('data.token 非空', () => pm.expect(res.data.token).to.be.a('string'));",
                                    "pm.collectionVariables.set('idemToken', res.data.token);",
                                    "console.log('幂等令牌已保存:', res.data.token, 'TTL=', res.data.expiresInSeconds, 's');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/idempotent/token",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "idempotent",
                                "token"
                            ]
                        },
                        "description": "后端 SET key=idem:seata:{uuid}、value=用户标识、TTL 300s。令牌只能用一次。"
                    }
                },
                {
                    "name": "7.2 携令牌首次下单（应 200，余额 -66）",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                                    "pm.test('下单成功', () => pm.expect(pm.response.json().data.success).to.eql(true));",
                                    "console.log('首次成功，令牌已被 Lua 原子删除；SQL: 余额 -66、t_order +1');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Idempotent-Token",
                                "value": "{{idemToken}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:9000/api/orders/seata/create-idem?userId=1&amount=66",
                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "seata",
                                "create-idem"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
