                            "host": [
                                "localhost"
                            ],
                            "port": "9000",
                            "path": [
                                "api",
                                "orders",
                                "seata",
                                "create"
                            ],
                            "query": [
                                {
                                    "key": "userId",
                                    "value": "1"
                                },
                                {
                                    "key": "amount",
                                    "value": "100"
                                },
                                {
                                    "key": "forceFail",
                                    "value": "true"
                                }
                            ]
