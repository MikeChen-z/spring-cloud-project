                                    "    pm.expect(res.code).to.eql(400);",
                                    "    pm.expect(res.message).to.include('用户名不能为空');",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
