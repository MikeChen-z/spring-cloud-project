<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.study</groupId>
        <artifactId>spring-cloud-study</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gateway-service</artifactId>
    <name>gateway-service</name>
    <description>统一入口网关：基于 WebFlux 的 Spring Cloud Gateway，按路径路由并通过 lb:// 做负载均衡</description>

    <dependencies>
        <!--
          注意：spring-cloud-starter-gateway 基于 WebFlux/Netty，
          本模块【不能】引入 spring-boot-starter-web（Servlet 栈），
          否则启动时会报 Spring MVC found on classpath, which is incompatible 错误。
          业务服务（user/order）继续用 MVC，互不影响。
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- 网关也要从 Nacos 发现下游服务，才能用 lb://服务名 路由 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus 注册表：把指标以 Prometheus 文本格式暴露在 /actuator/prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- 网关限流：RequestRateLimiter 基于 Redis 令牌桶，必须用 Reactive 版 Redis 客户端 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- JWT：网关对请求做验签（与 user-service 签发侧共用同一密钥，版本由父 POM 托管） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 链路追踪：Micrometer Tracing + Brave + Zipkin -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- Sentinel：Spring Cloud Alibaba Sentinel starter，自动检测 classpath 上的 Gateway，
             配置 SentinelGatewayFilter 实现路由级流控。配合 Sentinel Dashboard 可视化管理规则。
             与下面 Resilience4j CircuitBreaker 共存：Sentinel 负责 Dashboard 可视化 + 动态流控，
             Resilience4j 负责网关路由级熔断（fallbackUri 降级）。 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- 网关熔断：Spring Cloud Gateway 的 CircuitBreaker filter 基于 Reactive Resilience4j。
             当下游持续故障（失败率达阈值）时自动打开熔断器，直接 forward 到 fallbackUri 返回降级响应，
             不再把请求打到已挂的后端——给下游喘息恢复时间，也避免网关线程被慢响应拖垮。
             重试解决瞬时抖动，熔断解决持续故障，二者配合才完整。 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>

        <!-- JSON 格式日志：与 user/order 一致，堆栈不被 Docker 切散 -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
